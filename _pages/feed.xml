---
layout: null
permalink: /feed.xml
sitemap: false
---
{%- assign live_news = site.news | where_exp: "post", "post.layout != 'redirect'" -%}
{%- assign all_items = site.logbook | concat: live_news | concat: site.articles | sort: "date" | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title type="text">{{ site.title }}</title>
  <subtitle type="text">{{ site.tagline }} — گزارش صعود، خبر کوهنوردی و مقالات</subtitle>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ all_items.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name><uri>{{ site.author.url }}</uri></author>
  <rights>© {{ site.time | date: '%Y' }} {{ site.author.name | xml_escape }}</rights>
{% include atom-entries.html items=all_items %}
</feed>
