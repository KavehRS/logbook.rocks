---
layout: null
permalink: /news/feed.xml
sitemap: false
---
{%- assign items = site.news | where_exp: "post", "post.layout != 'redirect'" | sort: "date" | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title type="text">{{ site.author.name }} — خبر کوهنوردی</title>
  <subtitle type="text">ترجمهٔ خبرها و اطلاعیه‌های منابع معتبر بین‌المللی کوهنوردی</subtitle>
  <id>{{ '/news/feed.xml' | absolute_url }}</id>
  <link href="{{ '/news/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/news/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ items.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name><uri>{{ site.author.url }}</uri></author>
{% include atom-entries.html items=items %}
</feed>
